.vscode*

# Tool-use telemetry log + rotations + lock file
# Per plan baby-phi/docs/specs/permissions/tool-use-logging-and-permissions-audit-skill-18564835.md
.claude/tool-use.log
.claude/tool-use.log.*
.claude/tool-use.log.lock

.env

# Tag-mode worktrees for IPHI_SOURCE=tag (created on demand; transient)
iphi-worktrees/

# Parallel-development worktrees (git worktree add target; per-branch isolated trees).
# Each worktree at /root/projects/phi/worktrees/<name>/ is a separate phi checkout
# with its own i-phi/phi-core/baby-phi submodule checkouts on independent branches.
# Settings.json + docker-cargo.sh IPHI_WORKTREE_TAG support these out-of-the-box.
/worktrees/

# Backport-PR agent transient files (propagate-fixes skill): PR-body temp files +
# the scan-notifier's last-seen drift-id cache. The throwaway build worktree lives
# under .git/backport-work/ and is never tracked.
.claude/skills/propagate-fixes/.pr-body-*.md
.claude/skills/propagate-fixes/.last-scan